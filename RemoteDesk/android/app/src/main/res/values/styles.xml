<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#E5483E</color>
    <color name="accent_dark">#C23A31</color>
    <color name="bg">#F3F4F6</color>
    <color name="launcher_bg">#D93F35</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/accent_dark</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="SessionTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
