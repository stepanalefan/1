{
 "document": "ПИЛВ 0102-004, part 1 — BOS control commands over CAN 2.0B",
 "tables": "4.6 / 4.7 (commands to the BOS), 4.8 (commands sent by the BOS); data fields: tables 4.9-4.35",
 "format": {
  "id": "29-bit: (sender<<22)|(receiver<<16)|(ack request<<14)|(has data<<13)|code",
  "addresses": {
   "BOS": "0x29",
   "group": "0x0D",
   "sender_default": "0x18"
  },
  "data": "commands with data always carry 8 bytes (unused bytes 0x00); multi-byte values little-endian",
  "modes": "ДЖР = executed only in standby (the BOS rejects / ignores it during a session); all = any mode",
  "fields": "byte = first byte, len = bytes (LE), bits = [hi, lo] within the byte, scale = units per LSB, values = allowed codes, strict = other codes prohibited, zero_bits = must be 0"
 },
